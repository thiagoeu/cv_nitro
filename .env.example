GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Usado automaticamente quando o modelo principal retorna 503 (sobrecarga). Vazio desativa.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Reserva final quando o Gemini falha (cota 429 / 503). Vazio desativa.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GITHUB_TOKEN=your_github_token_here

# Credenciais opcionais do Supabase para persistência em nuvem (deploy)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
