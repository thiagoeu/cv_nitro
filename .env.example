# Obrigatória: assina o cookie de sessão. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=your-auth-secret-here

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Usado automaticamente quando o modelo principal retorna 503 (sobrecarga). Vazio desativa.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Reserva final quando o Gemini falha (cota 429 / 503). Vazio desativa.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GITHUB_TOKEN=your_github_token_here

# Supabase (opcional): as três variáveis juntas ativam o modo nuvem; faltando qualquer uma, tudo fica local
SUPABASE_URL=https://your-project.supabase.co
# Chave anon (pública): usada apenas para login e cadastro
SUPABASE_KEY=your-anon-key-here
# Chave service role (SEGREDO, só no servidor): acesso aos dados, sempre filtrado por user_id no app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
